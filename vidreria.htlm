<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, viewport-fit=cover">
    <title>Vidriería · La Franja · Catálogo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0B0B0B;
            color: #E0E0E0;
            overflow-x: hidden;
            line-height: 1.6;
        }
        :root {
            --gold: #C9A96E;
            --gold-light: #D4B87A;
            --dark-surface: #161616;
            --border-subtle: rgba(255, 255, 255, 0.06);
        }
        h1, h2, h3, h4, h5, h6 { font-weight: 600; letter-spacing: -0.01em; }

        .navbar-custom {
            background: rgba(11, 11, 11, 0.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(201, 169, 110, 0.15);
        }
        .navbar-brand span { color: #FFFFFF; font-weight: 700; }
        .nav-link { color: rgba(255,255,255,0.75) !important; font-weight: 500; transition: 0.2s; }
        .nav-link:hover, .nav-link.active { color: var(--gold) !important; }

        .page-header {
            background: #0B0B0B;
            border-bottom: 1px solid var(--border-subtle);
            padding: 70px 20px 60px;
            text-align: center;
            position: relative;
        }
        .page-header::before {
            content: "";
            position: absolute;
            top: -30%; left: -20%;
            width: 140%; height: 140%;
            background: radial-gradient(circle at 40% 50%, rgba(201,169,110,0.04) 0%, transparent 70%);
            pointer-events: none;
        }
        .page-header h1 { font-weight: 700; color: #FFFFFF; font-size: 3rem; }
        .section-badge {
            display: inline-block;
            font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05em;
            color: var(--gold);
            border: 1px solid rgba(201,169,110,0.4);
            padding: 0.4rem 1.4rem; border-radius: 50px;
            background: rgba(201,169,110,0.05); margin-bottom: 1rem;
        }

        .catalogo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
        }
        .producto-card {
            background: var(--dark-surface);
            border: 1px solid var(--border-subtle);
            border-radius: 24px; overflow: hidden;
            transition: all 0.3s ease;
            display: flex; flex-direction: column;
        }
        .producto-card:hover {
            transform: translateY(-6px);
            border-color: rgba(201,169,110,0.4);
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.6);
        }
        .img-container {
            width: 100%;
            height: 260px;
            background: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .img-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: 0.4s;
            filter: brightness(0.95);
        }
        .producto-card:hover .img-container img {
            transform: scale(1.03);
            filter: brightness(1);
        }
        .producto-info {
            padding: 1.5rem; display: flex; flex-direction: column;
            gap: 0.5rem; flex: 1;
        }
        .producto-info h3 { font-size: 1.2rem; color: #FFFFFF; }
        .producto-info p { font-size: 0.85rem; color: #A0A0A0; }
        .producto-footer {
            display: flex; justify-content: space-between;
            align-items: center; margin-top: 0.8rem;
        }
        .btn-consulta {
            background: transparent; border: 1px solid var(--gold);
            color: var(--gold); padding: 0.4rem 1.2rem;
            border-radius: 40px; font-weight: 600; font-size: 0.8rem;
            transition: 0.2s; text-decoration: none;
            display: inline-block;
        }
        .btn-consulta:hover { background: var(--gold); color: #0B0B0B; }

        footer {
            background: #0A0A0A;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 3rem; padding: 3rem 0;
        }

        /* Lightbox */
        .lightbox {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.92);
            z-index: 2000;
            align-items: center; justify-content: center;
            flex-direction: column;
        }
        .lightbox.active { display: flex; }
        .lightbox img {
            max-width: 90%;
            max-height: 85vh;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 0 40px rgba(0,0,0,0.5);
        }
        .lightbox-close {
            position: absolute;
            top: 20px; right: 30px;
            font-size: 2.5rem;
            color: var(--gold);
            cursor: pointer;
            background: none;
            border: none;
            line-height: 1;
        }
        .lightbox-close:hover { color: white; }

        @media (max-width: 768px) {
            .page-header h1 { font-size: 2.2rem; }
            .catalogo-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body data-categoria="vidrieria">

<nav class="navbar navbar-dark navbar-custom sticky-top py-2">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="index.html">
            <img src="logo.png" alt="Logo La Franja" width="42" height="42" style="border-radius: 14px;" onerror="this.src='https://via.placeholder.com/42?text=LF'">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">
                <li class="nav-item"><a class="nav-link" href="index.html">Inicio</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle active" href="#" data-bs-toggle="dropdown">Servicios</a>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" href="herreria.html">Herrería</a></li>
                        <li><a class="dropdown-item active" href="vidrieria.html">Vidriería</a></li>
                        <li><a class="dropdown-item" href="molduras.html">Molduras</a></li>
                        <li><a class="dropdown-item" href="pintura.html">Pintura</a></li>
                        <li><a class="dropdown-item" href="laminas.html">Láminas</a></li>
                        <li><a class="dropdown-item" href="ferreteria.html">Ferretería</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a class="nav-link" href="nosotros.html">Nosotros</a></li>
                <li class="nav-item"><a class="nav-link" href="contacto.html">Contacto</a></li>
                <li class="nav-item"><a class="nav-link" href="testimonios.html">Testimonios</a></li>
            </ul>
            <a href="tel:40507209" class="btn btn-outline-light rounded-pill px-3 py-1 fw-semibold ms-2 d-none d-md-inline-block" style="border-color: var(--gold); color: var(--gold);">📞 Llamar</a>
        </div>
    </div>
</nav>

<header class="page-header">
    <div class="container">
        <span class="section-badge mb-3">🪟 CATÁLOGO DE VIDRIERÍA</span>
        <h1 class="display-4 fw-bold mb-3">Vidrios, ventanales y más</h1>
        <p class="lead" style="color: #A0A0A0; max-width: 650px; margin: 0 auto;">
            Trabajos en cristal templado, laminado, aluminio y acabados de primera.
        </p>
    </div>
</header>

<main class="container my-5 py-3">
    <div id="catalogo-productos" class="catalogo-grid">
        <div class="text-center p-5" style="color: #A0A0A0; grid-column: 1 / -1;">
            <span class="material-symbols-outlined fs-1 mb-3" style="color: var(--gold);">window</span>
            <p>Cargando productos de vidriería...</p>
        </div>
    </div>
</main>

<section class="py-5" style="background: #0E0E0E;">
    <div class="container text-center">
        <span class="section-badge mb-4">✨ ¿NO ENCUENTRAS LO QUE BUSCAS?</span>
        <h3 class="fw-bold text-white mb-3">Hacemos realidad tu idea</h3>
        <p class="text-secondary mb-4">Envíanos una foto, un dibujo o una descripción y te cotizamos sin compromiso.</p>
        <a href="https://wa.me/50240507209?text=Hola,%20quiero%20información%20sobre%20trabajos%20de%20vidriería" class="btn" style="background: var(--gold); color: #0B0B0B; border: none; font-weight: 600; border-radius: 50px; padding: 0.7rem 2.2rem;" target="_blank">
            📲 Enviar idea por WhatsApp
        </a>
    </div>
</section>

<footer class="text-white py-4">
    <div class="container text-center">
        <p class="mb-1 fw-bold fs-5" style="color: #FFFFFF;">MULTISERVICIOS LA FRANJA</p>
        <p class="small" style="color: #A0A0A0;">San Antonio Las Cuevas, Raxruhá, Alta Verapaz — Calidad y confianza</p>
        <hr class="bg-secondary w-50 mx-auto my-3 opacity-25">
        <p class="small mb-0" style="color: #777;">© 2026 · Trabajos que hablan por sí mismos</p>
    </div>
</footer>

<!-- Lightbox -->
<div id="lightbox" class="lightbox">
    <button class="lightbox-close" id="lightbox-close">&times;</button>
    <img id="lightbox-img" src="" alt="Vista ampliada">
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const CATALOGO_CSV = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTb4miQna9vJW6nJIc4Gdt6LJDT2PzAodbfdkWJn-BALkNE7p6VRGYXFYrm4olyhXovhHFrlKrP8yrE/pub?gid=0&single=true&output=csv';

    function normalizar(str) {
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
    }

    async function cargarCatalogo() {
        const contenedor = document.getElementById('catalogo-productos');
        const categoriaPagina = normalizar(document.body.getAttribute('data-categoria'));

        if (!categoriaPagina) {
            contenedor.innerHTML = '<p class="text-center p-5">Categoría no definida.</p>';
            return;
        }

        try {
            const resp = await fetch(CATALOGO_CSV);
            const texto = await resp.text();
            const productos = parsearCSV(texto).filter(p => normalizar(p.categoria) === categoriaPagina);

            if (productos.length === 0) {
                contenedor.innerHTML = '<p class="text-center p-5">Pronto agregaremos productos aquí.</p>';
                return;
            }

            renderizarProductos(productos, contenedor);
            configurarLightbox();
        } catch (error) {
            contenedor.innerHTML = '<p class="text-center p-5 text-danger">Error al cargar productos.</p>';
        }
    }

    function parsearCSV(csv) {
        if (csv.charCodeAt(0) === 0xFEFF) csv = csv.slice(1);

        const lineas = csv.trim().split('\n');
        if (lineas.length < 2) return [];

        const parseLinea = (linea) => {
            const resultado = [];
            let actual = '';
            let entreComillas = false;
            for (let i = 0; i < linea.length; i++) {
                const char = linea[i];
                if (char === '"') {
                    entreComillas = !entreComillas;
                } else if (char === ',' && !entreComillas) {
                    resultado.push(actual.trim());
                    actual = '';
                } else {
                    actual += char;
                }
            }
            resultado.push(actual.trim());
            return resultado;
        };

        const cabeceras = parseLinea(lineas[0]).map(h => normalizar(h));
        const productos = [];
        for (let i = 1; i < lineas.length; i++) {
            const valores = parseLinea(lineas[i]);
            const obj = {};
            cabeceras.forEach((col, idx) => {
                obj[col] = valores[idx] !== undefined ? valores[idx] : '';
            });
            productos.push(obj);
        }
        return productos;
    }

    function renderizarProductos(productos, contenedor) {
        let html = '';
        productos.forEach(p => {
            const tieneColumnaTitulo = p.titulo !== undefined;
            const titulo = p.titulo || p.descripcion || 'Producto';
            const descripcion = tieneColumnaTitulo ? (p.descripcion || '') : '';
            const precio = p.precio || 'Consultar';
            const imagenUrl = p.imagen_url || '';

            html += `
                <div class="producto-card">
                    <div class="img-container" data-full-img="${imagenUrl}">
                        <img src="${imagenUrl}" alt="${titulo}" loading="lazy" 
                             onerror="this.onerror=null; this.parentElement.innerHTML='<span style=color:#C9A96E>Sin imagen</span>';">
                    </div>
                    <div class="producto-info">
                        <h3>${titulo}</h3>
                        <p>${descripcion}</p>
                        <div class="producto-footer">
                            <span style="color: var(--gold); font-weight:500;">${precio}</span>
                            <a href="https://wa.me/50240507209?text=Hola,%20me%20interesa%20${encodeURIComponent(titulo)}" target="_blank" class="btn-consulta">Consultar</a>
                        </div>
                    </div>
                </div>
            `;
        });
        contenedor.innerHTML = html;
    }

    function configurarLightbox() {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const closeBtn = document.getElementById('lightbox-close');

        document.querySelectorAll('.img-container').forEach(container => {
            container.addEventListener('click', function(e) {
                const fullImg = this.getAttribute('data-full-img');
                if (fullImg) {
                    lightboxImg.src = fullImg;
                    lightbox.classList.add('active');
                }
            });
        });

        closeBtn.addEventListener('click', () => {
            lightbox.classList.remove('active');
        });
        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) {
                lightbox.classList.remove('active');
            }
        });
    }

    cargarCatalogo();
</script>
</body>
</html>
